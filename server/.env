# --- Environment Variables ---

# Server Configuration
NODE_ENV=development
PORT=4000

# Database (Replace with your actual MongoDB connection string)
MONGO_URI=mongodb://localhost:27017/dog-id-secure-app

# Frontend URL (For CORS configuration)
CLIENT_URL=http://localhost:5173


# Security (Will be used in Phase 1)
JWT_SECRET=YOUR_VERY_SECRET_JWT_KEY_REPLACE_ME
JWT_EXPIRES_IN=30d

# Add other API keys or secrets as needed

# --- IMPORTANT ---
# 1. DO NOT commit this file to Git. Add `.env` to your server/.gitignore file.
# 2. Use strong, unique secrets, especially for JWT_SECRET.
# 3. Manage production environment variables securely (e.g., through hosting provider settings).